# MealTrack Environment Configuration

# Food Recognition API Configuration
# The app works without these, but accuracy improves with API integration

# Option 1: CalorieNinjas API (Recommended)
# Free tier: 100 requests/month
# Sign up at: https://calorieninjas.com/api
CALORIE_NINJAS_API_KEY=

# Option 2: Edamam Food Database API
# Free tier: 10,000 requests/month
# Sign up at: https://developer.edamam.com/
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Note: Only one API is needed. The app will use CalorieNinjas if both are configured.
# If no API keys are provided, the app will use estimated macro values.
